# Postgres (used by docker-compose db + DATABASE_URL)
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=financedb
DATABASE_URL=postgresql://your_user:your_password@db:5432/financedb

# JWT (API)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# AI suggestions (API)
GEMINI_API_KEY=your_gemini_api_key

# Frontend API base URL lives in frontend/.env.example (VITE_API_URL).
# For local Vite: http://localhost:8000
# For Vercel: set VITE_API_URL in the Vercel dashboard to your Render URL.
