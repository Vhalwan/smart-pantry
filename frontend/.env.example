# Copied by Vite when you run the frontend (see also .env / .env.local).
# Local Docker Compose API:
VITE_API_URL=http://localhost:8000

# On Vercel, set VITE_API_URL in the project Environment Variables to your
# Render backend URL (e.g. https://your-service.onrender.com). Do not put the
# production URL in a local .env / .env.local unless you mean to hit production.
